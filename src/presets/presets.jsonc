{
  // 内置模型清单（只读，随包分发）。
  // ⚠ 修改会随插件升级/重装被覆盖；用户自定义模型请用设置页「我的模型」（custom-models.jsonc）。
  // 字段说明：
  //   - modelUrl   : .model3.json 地址。内置模型随包分发，走 Host 同源 /pet-assets/models/<id>/ 路由
  //   - animationMap: 状态动画映射（Idle/Thinking/Error/Done/Waiting 动作组名）
  //   - touchParts : 默认触摸部位（用户保存过自定义部位后以其为准，见 touch-parts.jsonc）
  "version": 4,
  "presets": [
    {
      "id": "jian",
      "name": "简",
      "author": "用户自备模型",
      "modelUrl": "/pet-assets/models/jian/简.model3.json",
      "license": {
        "type": "用户自备模型（随包内置；公开分发前请确认模型授权）",
        "url": "https://www.live2d.com/eula/"
      },
      "cubism": 4,
      "status": "bundled",
      // 简的动作组（assets/models/jian/motions/ 自建，ADR-014）
      "animationMap": {
        "idle": ["Idle"],
        "thinking": ["Thinking"],
        "error": ["Error"],
        "done": ["Done"],
        "waiting": ["Waiting"],
        "delivered": ["Done"]
      },
      // 默认触摸部位（按「简」实际渲染构图调好的取值，用户可在设置页覆盖/增删）。
      // 数组顺序 = 图层顺序（第 0 项最上层）：脸 > 头 > 胸 > 臀（spec §4）。
      "touchParts": [
        {
          "id": "face",
          "name": "脸",
          "boxes": [{ "left": 0.37, "top": 0.12, "right": 0.59, "bottom": 0.2 }],
          "motions": ["TapFace"],
          "lines": ["别捏脸啦～", "脸要被你捏变形了…", "呀…别戳脸！"]
        },
        {
          "id": "head",
          "name": "头",
          "boxes": [{ "left": 0.34, "top": 0.06, "right": 0.67, "bottom": 0.21 }],
          "motions": ["TapHead"],
          "lines": ["摸头…好舒服…", "头发被弄乱啦～", "再、再摸一下也不是不行…"]
        },
        {
          "id": "chest",
          "name": "胸",
          "boxes": [{ "left": 0.24, "top": 0.22, "right": 0.64, "bottom": 0.34 }],
          "motions": ["TapBody"],
          "lines": ["呀！那里不能戳啦…", "衣服要乱了…", "喂，往哪里看呢。"]
        },
        {
          "id": "hip",
          "name": "臀",
          "boxes": [{ "left": 0.28, "top": 0.36, "right": 0.69, "bottom": 0.53 }],
          "motions": ["TapBody"],
          "lines": ["笨、笨蛋！", "那里绝对不行！", "再这样我要生气了哦。"]
        }
      ]
    }
  ]
}
